# Backend configuration (server/server.js loads this file from the project root
# when it is copied to .env).
HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/jharkhand-innovation-portal
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_characters
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Frontend build-time configuration. Leave empty for local development through
# the Next.js localhost rewrite.
NEXT_PUBLIC_API_URL=
