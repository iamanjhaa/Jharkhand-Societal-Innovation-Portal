HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/jharkhand_innovation
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_characters
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SAHAYAK_API_URL=http://localhost:8000
SMS_PROVIDER=
SMS_ACCOUNT_ID=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=
# Server-only OpenAI Whisper transcription; keep the API key out of NEXT_PUBLIC_*.
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1

# Blood assistance integration
BLOOD_AVAILABILITY_PROVIDER=eRaktKosh
# API Setu Stock nearby endpoint. Override only if an authorized endpoint differs.
BLOOD_AVAILABILITY_API_URL=https://apigw.umangapp.in/umang/apisetu/dept/eraktkoshiapi/ws1/stocknearby
# Server-only API Setu credentials; never expose these through NEXT_PUBLIC_*.
BLOOD_AVAILABILITY_CLIENT_ID=
BLOOD_AVAILABILITY_API_KEY=
# Optional API Setu values: set only when issued/required for this application.
BLOOD_AVAILABILITY_TENANT_ID=
BLOOD_AVAILABILITY_TOKEN=
BLOOD_AVAILABILITY_USER_ID=
